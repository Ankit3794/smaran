{
  "expo": {
    "name": "Smaran",
    "slug": "smaran",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smaran",
    "userInterfaceStyle": "light",
    "android": {
      "package": "app.smaran",
      "adaptiveIcon": {
        "backgroundColor": "#C8553D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F2EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-background-task",
      "./modules/share-receiver/plugin/withShareReceiver.js",
      "expo-sharing",
      "./plugins/withReleaseSigning.js",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (used by expo-background-task) creates its Room database by reflection.\n# Room 2.6's own rule keeps the class but not its constructor, so R8 strips it and the release app crashes at launch.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "app.smaran"
    }
  }
}
