<?xml version="1.0" encoding="utf-8"?>
<!-- The confirmation card ShareActivity shows for 1.5 s after a share (the "savedToast" in the Direction A mockup).
     The full-screen root is transparent; tapping it dismisses the card. System fonts stand in for Fraunces/Inter,
     because bundling the app's fonts into this tiny native screen is not worth the extra weight. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/share_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <LinearLayout
      android:id="@+id/share_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:layout_margin="12dp"
      android:background="@drawable/share_card_background"
      android:clickable="true"
      android:elevation="12dp"
      android:orientation="vertical"
      android:paddingStart="14dp"
      android:paddingTop="12dp"
      android:paddingEnd="14dp"
      android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <TextView
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:background="@drawable/share_badge_background"
          android:fontFamily="serif"
          android:gravity="center"
          android:text="S"
          android:textColor="@color/share_accent_ink"
          android:textSize="17sp"
          android:textStyle="bold" />

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="11dp"
          android:layout_weight="1"
          android:orientation="vertical">

        <TextView
            android:id="@+id/share_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saved to Smaran"
            android:textColor="@color/share_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/share_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Sorting it into a topic…"
            android:textColor="@color/share_muted"
            android:textSize="13sp" />
      </LinearLayout>
    </LinearLayout>

    <!-- Hidden until "Add a note" is tapped. -->
    <EditText
        android:id="@+id/share_note_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/share_note_background"
        android:hint="Why are you saving this?"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="4"
        android:padding="11dp"
        android:textColor="@color/share_ink"
        android:textColorHint="@color/share_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/share_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

      <TextView
          android:id="@+id/share_add_note"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginEnd="8dp"
          android:layout_weight="1"
          android:background="@drawable/share_button_background"
          android:focusable="true"
          android:gravity="center"
          android:padding="9dp"
          android:text="Add a note"
          android:textColor="@color/share_ink"
          android:textSize="13sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/share_undo"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:background="@drawable/share_button_background"
          android:focusable="true"
          android:gravity="center"
          android:padding="9dp"
          android:text="Undo"
          android:textColor="@color/share_ink"
          android:textSize="13sp"
          android:textStyle="bold" />
    </LinearLayout>

    <!-- Replaces the two buttons while the note is being written. -->
    <TextView
        android:id="@+id/share_save_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/share_primary_button_background"
        android:focusable="true"
        android:gravity="center"
        android:padding="10dp"
        android:text="Save note"
        android:textColor="@color/share_accent_ink"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
  </LinearLayout>
</FrameLayout>
