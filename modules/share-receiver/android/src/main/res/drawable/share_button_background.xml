<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined secondary button (Undo, Add a note) with a touch ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/share_pressed">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/share_card" />
      <stroke android:width="1dp" android:color="@color/share_line" />
      <corners android:radius="14dp" />
    </shape>
  </item>
</ripple>
